# Copy to deploy/.env and fill in. Never commit the real .env.

# @BotFather token and the bot's username (without @)
SAHIFA_BOT_TOKEN=123456789:AAH...
SAHIFA_BOT_USERNAME=SahifaBot

# Telegram user ids of admins, and the group where card receipts arrive
# (add the bot to that group; group ids start with -100)
SAHIFA_ADMIN_IDS=[123456789]
SAHIFA_ADMIN_CHAT_ID=-1001234567890

# Public HTTPS address of this server (Tailscale Funnel), no trailing slash
SAHIFA_PUBLIC_API_URL=https://sahifa.tailXXXX.ts.net

# Mini App address (GitHub Pages), no trailing slash
SAHIFA_WEBAPP_URL=https://USERNAME.github.io/sahifa
